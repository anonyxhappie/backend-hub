{
  "name": "backend-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable multi-tenant backend foundation, SDK, and example static app for a portfolio of static UIs.",
  "scripts": {
    "dev": "node server/cli.js serve",
    "migrate": "node server/cli.js migrate",
    "seed": "node server/cli.js seed",
    "reconcile": "node server/cli.js reconcile",
    "build:sdk": "node scripts/build-sdk.js",
    "test": "node --test tests/*.test.js",
    "test:migrations": "node --test tests/migrations.test.js",
    "test:security": "node --test tests/rls-adversarial.test.js tests/storage-adversarial.test.js tests/functions-and-quotas.test.js",
    "test:e2e": "node --test tests/sdk-and-e2e.test.js",
    "lint": "node scripts/lint.js",
    "format:check": "node scripts/format-check.js",
    "ci": "npm run build:sdk && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
