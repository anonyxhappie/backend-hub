# Backend Hub environment template (copy to .env for local overrides; never commit real secrets)
# Local development works with `npm run dev` without setting secrets,
# whereas staging and production FAIL CLOSED unless explicit secrets are set.

HUB_ENV=local
HUB_PORT=4000
HUB_UI_PORT=4100
HUB_DATA_DIR=.local-hub/pgdata
HUB_STORAGE_DIR=.local-hub/storage

# Replace with generated >= 32-character random secrets in staging/production (stored in secret manager, never git)
HUB_JWT_SECRET=local-dev-only-jwt-secret-change-me-32chars
HUB_SERVICE_ROLE_KEY=local-dev-only-service-key-change-me-32chars
